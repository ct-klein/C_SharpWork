{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Unit Tests (Current Project)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/test-generator/generate-tests.js",
        "${fileDirname}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Generate Unit Tests (Current File)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/test-generator/generate-tests.js",
        "${fileDirname}",
        "--file",
        "${fileBasename}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Generate Unit Tests (Workspace)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/test-generator/generate-tests.js",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Tests with Coverage",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/",
        "/p:CollectCoverage=true",
        "/p:CoverletOutputFormat=opencover"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
